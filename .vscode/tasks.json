{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Flask app",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["app.py"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Serve GitHub Pages demo",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "http.server", "8000", "--directory", "docs"],
      "problemMatcher": []
    }
  ]
}
